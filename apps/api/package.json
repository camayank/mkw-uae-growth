{
  "name": "@tasees/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEV_LOGIN=1 tsx watch src/main.ts",
    "demo": "DEV_LOGIN=1 PAYMENT_WEBHOOK_SECRET=dev-secret tsx src/main.ts",
    "seed": "tsx src/scripts/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=production dist/main.js",
    "jobs": "node --conditions=production dist/scripts/run-jobs.js",
    "import:sheet": "node --conditions=production dist/scripts/import-sheet.js",
    "import": "node --conditions=production dist/scripts/import.js",
    "import:dev": "tsx src/scripts/import.ts",
    "create-founder": "node --conditions=production dist/scripts/create-founder.js",
    "verify:audit": "node --conditions=production dist/scripts/verify-audit.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@tasees/core": "workspace:*",
    "csv-parse": "5.6.0",
    "fastify": "5.2.0",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
